          <mxGeometry x="875" y="430" width="210" height="110" as="geometry" />
        </mxCell>

        <!-- ============ WINDOWS VM ============ -->
        <mxCell id="win" value="&lt;b style=&#x27;font-size:15px;color:#e8eaed&#x27;&gt;Windows VM &amp;#8212; running on KVM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#9aa0a8&#x27; style=&#x27;font-size:11px&#x27;&gt;full Windows guest on a Linux-only cluster&lt;br&gt;&amp;#183;&lt;br&gt;native C / Rust compilation, no cross-compilation&lt;br&gt;VirtIO drivers &amp;#183; vCPU / vRAM / vDisk&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a2028;strokeColor=#E57373;strokeWidth=2.5;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="640" width="450" height="175" as="geometry" />
        </mxCell>
        <mxCell id="disk" value="&lt;b style=&#x27;font-size:13px;color:#e8eaed&#x27;&gt;Boot disk (PVC)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#9aa0a8&#x27; style=&#x27;font-size:11px&#x27;&gt;win.qcow2 &amp;#183; Packer + QEMU&lt;br&gt;unattended.xml install&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 5;fillColor=none;strokeColor=#9E9E9E;strokeWidth=2;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1120" y="430" width="250" height="110" as="geometry" />
        </mxCell>

        <!-- ============ EXTERNAL ============ -->
        <mxCell id="ci" value="&lt;b style=&#x27;font-size:14px;color:#e8eaed&#x27;&gt;GitLab CI&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#9aa0a8&#x27; style=&#x27;font-size:11px&#x27;&gt;triggers the job&lt;br&gt;&amp;#183;&lt;br&gt;whole environment rebuilt&lt;br&gt;from scratch on every run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 5;fillColor=none;strokeColor=#9E9E9E;strokeWidth=2;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="30" y="420" width="180" height="180" as="geometry" />
        </mxCell>
        <mxCell id="kvm" value="&lt;b style=&#x27;font-size:13px;color:#e8eaed&#x27;&gt;/dev/kvm passthrough&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#9aa0a8&#x27; style=&#x27;font-size:11px&#x27;&gt;VT-x / AMD-V&lt;br&gt;&amp;#8595; ESXi host&lt;br&gt;&amp;#8595; Debian VM&lt;br&gt;&amp;#8595; privileged container&lt;br&gt;&amp;#8595; kind node&lt;br&gt;&amp;#8595; virt-launcher&lt;br&gt;&amp;#8595; Windows VM&lt;br&gt;&amp;#183;&lt;br&gt;kernel modules checked to&lt;br&gt;rule out emulation fallback&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 5;fillColor=none;strokeColor=#9B6BE8;strokeWidth=2;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1550" y="270" width="240" height="380" as="geometry" />
        </mxCell>
        <mxCell id="prod" value="&lt;b style=&#x27;font-size:13px;color:#e8eaed&#x27;&gt;Production target&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&#x27;#9aa0a8&#x27; style=&#x27;font-size:11px&#x27;&gt;RKE2 on native&lt;br&gt;Windows and Linux servers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=7 5;fillColor=none;strokeColor=#9E9E9E;strokeWidth=2;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="1550" y="670" width="240" height="115" as="geometry" />
        </mxCell>

